# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore all root-level markdown files except README.md
/*.md
!/README.md

# Ignore the directory for local files during development
local/

# Ignore Ruby/Bundler build artifacts
.bundle/
vendor/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json
# Generated audit/build intermediates
/tmp/
/output/
